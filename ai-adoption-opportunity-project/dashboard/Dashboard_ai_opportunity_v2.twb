    <worksheet name='ROI_panel5'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#00007f' fontname='Tableau Book' fontsize='12'>The financial return</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='data (benchmarks)' name='federated.08d2t9217nk25m1brqx8w0lvch7l' />
          </datasources>
          <datasource-dependencies datasource='federated.08d2t9217nk25m1brqx8w0lvch7l'>
            <column caption='Scenario Grouped' datatype='string' name='[Calculation_0294955122532353]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [scenario] = &quot;AI adoption&quot; THEN &quot;AI&quot;&#13;&#10;ELSE [scenario]&#13;&#10;END' />
              <aliases>
                <alias key='&quot;AI&quot;' value='With AI' />
                <alias key='&quot;Manual&quot;' value='Baseline' />
              </aliases>
            </column>
            <column caption='ROI Display' datatype='string' name='[Calculation_0294955122896898]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [metric] = &quot;First-year ROI&quot; &#13;&#10;THEN &quot;20-140%&quot;&#13;&#10;ELSEIF [metric] = &quot;Payback period&quot;&#13;&#10;THEN &quot;3-4 months&quot;&#13;&#10;ELSEIF [metric] = &quot;Cost per invoice&quot; AND [scenario] = &quot;Manual&quot;&#13;&#10;THEN &quot;USD 12-20&quot;&#13;&#10;ELSEIF [metric] = &quot;Cost per invoice&quot; AND [scenario] = &quot;AI&quot;&#13;&#10;THEN &quot;USD 2-3&quot;&#13;&#10;ELSEIF [metric] = &quot;Accounts payable cycle time - manual&quot;&#13;&#10;THEN &quot;45 days → 12 days (with AI)&quot;&#13;&#10;ELSEIF [metric] = &quot;Margin improvement for 3PL&quot;&#13;&#10;THEN &quot;+30-75%&quot;&#13;&#10;ELSE STR([kpi_value])&#13;&#10;END' />
            </column>
            <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
            <column caption='Kpi Value' datatype='real' name='[kpi_value]' role='measure' type='quantitative' />
            <column caption='Metric' datatype='string' name='[metric]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Accounts payable cycle time - AI&quot;' value='AP cycle time — with AI (days)' />
                <alias key='&quot;Accounts payable cycle time - manual&quot;' value='AP cycle time — manual (days)' />
                <alias key='&quot;First-year ROI&quot;' value='First-year ROI (conservative estimate)' />
                <alias key='&quot;Logistics companies adopting AI&quot;' value='Large enterprises' />
                <alias key='&quot;Logistics cost reduction - AI adopters&quot;' value='Logistics Cost' />
                <alias key='&quot;Margin improvement for 3PL&quot;' value='Margin improvement' />
                <alias key='&quot;Mid-size logistics providers with AI&quot;' value='Mid-size providers' />
                <alias key='&quot;Payback period&quot;' value='Payback period (estimated)' />
                <alias key='&quot;Service level improvement&quot;' value='Service Level' />
              </aliases>
            </column>
            <column-instance column='[Calculation_0294955122532353]' derivation='None' name='[none:Calculation_0294955122532353:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0294955122896898]' derivation='None' name='[none:Calculation_0294955122896898:nk]' pivot='key' type='nominal' />
            <column-instance column='[category]' derivation='None' name='[none:category:nk]' pivot='key' type='nominal' />
            <column-instance column='[metric]' derivation='None' name='[none:metric:nk]' pivot='key' type='nominal' />
            <column caption='Scenario' datatype='string' name='[scenario]' role='dimension' type='nominal' />
          </datasource-dependencies>
