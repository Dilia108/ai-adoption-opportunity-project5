      <column caption='Latest Customs Score' datatype='real' name='[Calculation_2052524113694729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_name] : MAX(IF [indicator_label] = &quot;customs_score&quot; THEN [value] END) }' />
      </column>
      <column caption='Customs Rank' datatype='real' name='[Calculation_2052524116099082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_name] : MIN(IF [indicator_label] = &quot;customs_rank&quot; &#13;&#10;AND [year] = 2016 THEN [value] END) }' />
      </column>
      <column caption='Latest Customs Rank' datatype='real' name='[Calculation_2052524134998027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_name] : MAX(IF [indicator_label] = &quot;customs_rank&quot; THEN [value] END) }' />
      </column>
      <column caption='Customs Rank Display' datatype='string' name='[Calculation_2052524135927820]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT({ FIXED [country_name] : MIN(IF [indicator_label] = &quot;customs_rank&quot; &#13;&#10;AND [year] = 2016 THEN [value] END) })) + &quot; of 139&quot;' />
      </column>
