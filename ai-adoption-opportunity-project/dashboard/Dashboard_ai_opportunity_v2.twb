      <aliases enabled='yes' />
      <column caption='Scenario type' datatype='string' name='[Calculation_0294955023937536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [scenario] = &quot;Manual&quot; THEN &quot;Manual&quot; ELSE &quot;AI&quot; END' />
      </column>
      <column caption='Scenario Grouped' datatype='string' name='[Calculation_0294955122532353]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [scenario] = &quot;AI adoption&quot; THEN &quot;AI&quot;&#13;&#10;ELSE [scenario]&#13;&#10;END' />
        <aliases>
          <alias key='&quot;AI&quot;' value='With AI' />
          <alias key='&quot;Manual&quot;' value='Baseline' />
        </aliases>
      </column>
      <column caption='ROI Display' datatype='string' name='[Calculation_0294955122896898]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [metric] = &quot;First-year ROI&quot; &#13;&#10;THEN &quot;20-140%&quot;&#13;&#10;ELSEIF [metric] = &quot;Payback period&quot;&#13;&#10;THEN &quot;3-4 months&quot;&#13;&#10;ELSEIF [metric] = &quot;Cost per invoice&quot; AND [scenario] = &quot;Manual&quot;&#13;&#10;THEN &quot;USD 12-20&quot;&#13;&#10;ELSEIF [metric] = &quot;Cost per invoice&quot; AND [scenario] = &quot;AI&quot;&#13;&#10;THEN &quot;USD 2-3&quot;&#13;&#10;ELSEIF [metric] = &quot;Accounts payable cycle time - manual&quot;&#13;&#10;THEN &quot;45 days → 12 days (with AI)&quot;&#13;&#10;ELSEIF [metric] = &quot;Margin improvement for 3PL&quot;&#13;&#10;THEN &quot;+30-75%&quot;&#13;&#10;ELSE STR([kpi_value])&#13;&#10;END' />
      </column>
      <column caption='KPI Label - ErrorRate' datatype='string' name='[Calculation_2052524041457664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;8–15%&quot;' />
      </column>
      <column caption='KPI Display - ErrorRate' datatype='string' name='[Calculation_2052524042158081]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='MID([notes], FIND([notes], &quot;8&quot;), FIND([notes], &quot;%&quot;) - FIND([notes], &quot;8&quot;) + 1)' />
      </column>
      <column caption='KPI Display - CostPerInvoice' datatype='string' name='[Calculation_2052524045479938]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;$&quot; + STR(INT(MIN([kpi_value]))) + &quot;–&quot; + STR(INT(MAX([kpi_value])))' />
      </column>
      <column caption='KPI Display - TimePerDoc' datatype='string' name='[Calculation_2052524046438403]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT([kpi_value] / 60)) + &quot;+ min&quot;' />
      </column>
      <column caption='KPI Display - APCycleTime' datatype='string' name='[Calculation_2052524046983172]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT([kpi_value])) + &quot; days&quot;' />
      </column>
      <column caption='Gauge - Error Rate' datatype='real' name='[Calculation_2052524069740549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [metric] = &quot;Error rate&quot; AND [scenario] = &quot;Manual&quot; THEN [kpi_value] END)' />
      </column>
      <column caption='Gauge - Accuracy' datatype='real' name='[Calculation_2052524069810182]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100 - [Calculation_2052524069740549]' />
      </column>
      <column caption='Gauge - Placeholder' datatype='integer' name='[Calculation_2052524069953543]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(75)' />
      </column>
      <column caption='Gauge - Placeholder2' datatype='integer' name='[Calculation_2052524093702152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(25)' />
      </column>
